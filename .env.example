# ---------------------------------------------------------------------------
# Variables des scripts hors CMS (libs/format-adapters : import:tee,
# export:grist, setup:grist, snapshot:upstream).
# Nx charge ce fichier pour tous les projets ; les variables du CMS vivent dans
# apps/cms/.env (voir apps/cms/.env.example).
# Copier ce fichier en `.env` et adapter les valeurs.
# ---------------------------------------------------------------------------

# Store canonical (schéma `canonical` du Postgres local, `pnpm db:up`).
# Obligatoire pour import:tee / export:grist en local. Sur Scalingo, ne rien
# définir : repli sur SCALINGO_POSTGRESQL_URL.
CANONICAL_DATABASE_URI=postgres://tee:tee@localhost:5432/tee

# Repli sur la copie versionnée des fichiers amont (libs/format-adapters/static/upstream/)
# quand GitHub est en panne (réseau, timeout, 5xx ; jamais sur un 404 ni un JSON
# invalide). Désactivé par défaut et REFUSÉ sur Scalingo : ne jamais la définir
# sur la prod ni la préprod.
TEE_UPSTREAM_LOCAL_FALLBACK=1

# Sources amont. Les valeurs par défaut pointent vers le dépôt
# betagouv/mission-transition-ecologique : à ne surcharger qu'en cas de
# déménagement de la source.
# TEE_PROGRAMS_URL=https://raw.githubusercontent.com/betagouv/mission-transition-ecologique/main/libs/data/static/programs.json
# TEE_PROJECTS_URL=https://raw.githubusercontent.com/betagouv/mission-transition-ecologique/main/libs/data/static/projects.json
# TEE_REDIRECTS_URL=https://raw.githubusercontent.com/betagouv/mission-transition-ecologique/main/libs/data/static/redirects.json

# Export Grist. Sans ces valeurs, export:grist reste en dry run.
# GRIST_BASE_URL=https://grist.numerique.gouv.fr
# GRIST_DOC_ID=votre-doc-id
# GRIST_TABLE_ID=Dispositifs
# GRIST_API_KEY=votre-cle-api
# GRIST_PUSH=1
