{
  "name": "@tee-backoffice/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm generate && nx run @tee-backoffice/cms:dev -- --turbopack",
    "build": "pnpm generate && nx run @tee-backoffice/cms:build",
    "start": "cd apps/cms && ../../node_modules/.bin/next start",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "lint:fix:affected": "nx affected -t lint --fix",
    "typecheck": "nx run @tee-backoffice/cms:typecheck",
    "e2e": "nx run @tee-backoffice/cms:e2e",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "generate:importmap": "nx run @tee-backoffice/cms:generate:importmap",
    "generate:types": "nx run @tee-backoffice/cms:generate:types",
    "seed": "nx run @tee-backoffice/cms:seed",
    "seed:scalingo": "cd apps/cms && tsx src/scripts/seed/run.ts",
    "scalingo:postdeploy": "cd apps/cms && tsx src/scripts/postdeploy/run.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres",
    "migrate": "nx run @tee-backoffice/cms:migrate",
    "migrate:create": "nx run @tee-backoffice/cms:migrate:create",
    "migrate:status": "nx run @tee-backoffice/cms:migrate:status",
    "export:tee": "nx run @tee-backoffice/format-adapters:export:tee",
    "data:snapshot": "tsx libs/format-adapters/scripts/snapshot-upstream.ts",
    "data:daily": "tsx libs/format-adapters/scripts/import-tee.ts --remote && tsx libs/format-adapters/scripts/grist-setup.ts && tsx libs/format-adapters/scripts/export-grist.ts --push",
    "data:daily:dev": "nx run @tee-backoffice/format-adapters:import:tee --remote && nx run @tee-backoffice/format-adapters:setup:grist && nx run @tee-backoffice/format-adapters:export:grist --push",
    "test": "nx run @tee-backoffice/cms:test",
    "test:unit": "nx run @tee-backoffice/cms:test:unit"
  },
  "private": true,
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "drizzle-orm": "^0.45.2",
    "next": "15.4.11",
    "payload": "^3.90.2",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.34.2",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.5",
    "@nx/devkit": "22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/next": "22.5.4",
    "@nx/playwright": "22.5.4",
    "@playwright/test": "^1.58.2",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "25.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript-eslint/utils": "^8.57.1",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "eslint": "~9.39.4",
    "eslint-config-next": "15.4.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "nx": "22.5.4",
    "prettier": "^2.8.8",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "less",
      "libsql",
      "nx",
      "sharp",
      "unrs-resolver"
    ]
  }
}
