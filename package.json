{
  "name": "@tee-backoffice/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm generate && nx run @tee-backoffice/cms:dev -- --turbopack",
    "build": "pnpm generate && nx run @tee-backoffice/cms:build",
    "start": "cd apps/cms && ../../node_modules/.bin/next start",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "lint:fix:affected": "nx affected -t lint --fix",
    "typecheck": "nx run @tee-backoffice/cms:typecheck",
    "e2e": "nx run @tee-backoffice/cms-e2e:e2e",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "generate:importmap": "nx run @tee-backoffice/cms:generate:importmap",
    "generate:types": "nx run @tee-backoffice/cms:generate:types",
    "seed": "nx run @tee-backoffice/cms:seed",
    "test": "nx run @tee-backoffice/cms:test"
  },
  "private": true,
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.79.1",
    "libsql": "0.4.7",
    "@payloadcms/next": "^3.79.1",
    "@payloadcms/richtext-lexical": "^3.79.1",
    "@payloadcms/translations": "^3.79.1",
    "@payloadcms/ui": "^3.79.1",
    "next": "15.4.11",
    "payload": "^3.79.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@nx/devkit": "22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/next": "22.5.4",
    "@nx/playwright": "22.5.4",
    "@playwright/test": "^1.58.2",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript-eslint/utils": "^8.57.1",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "eslint": "~9.39.4",
    "eslint-config-next": "15.4.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "nx": "22.5.4",
    "prettier": "^2.8.8",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "less",
      "libsql",
      "nx",
      "sharp",
      "unrs-resolver"
    ]
  }
}
