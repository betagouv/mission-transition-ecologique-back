{
  "name": "@tee-backoffice/data-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/data-hub/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "export:tee": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/exports/tee.ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    }
  }
}
