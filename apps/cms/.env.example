# ---------------------------------------------------------------------------
# Variables d'environnement du CMS
# Toutes sont lues via `src/config/Config.ts` (point d'entrée unique).
# Copier ce fichier en `.env` et adapter les valeurs.
# ---------------------------------------------------------------------------

# PayloadCMS : secret de signature des tokens. Obligatoire.
# En prod, utiliser une valeur longue et aléatoire (`openssl rand -hex 32`).
PAYLOAD_SECRET=change-me-en-local

# Base Payload, LOCALE UNIQUEMENT (Postgres de `pnpm db:up`).
# Ne JAMAIS définir DATABASE_URI (ni CANONICAL_DATABASE_URI) sur Scalingo :
# elle prime sur SCALINGO_POSTGRESQL_URL, le DSN de l'addon, et une valeur
# locale y fait échouer le CMS (ECONNREFUSED 127.0.0.1:5432).
DATABASE_URI=postgres://tee:tee@localhost:5432/tee

# Taille du pool de connexions Postgres. Optionnel, défaut : 5.
# DATABASE_POOL_MAX=5

# Store canonical (schéma `canonical`), LOCALE UNIQUEMENT (Postgres de `pnpm db:up`).
# Ne JAMAIS définir CANONICAL_DATABASE_URI sur Scalingo : elle prime sur
# SCALINGO_POSTGRESQL_URL, et une valeur locale y fait échouer le store canonical.
CANONICAL_DATABASE_URI=postgres://tee:tee@localhost:5432/tee

# URL publique des liens absolus AGIR (index /api/agir/programs).
# Optionnel : sans elle, les liens viennent des en-têtes du reverse proxy,
# puis de l'origine de la requête. À définir si ces en-têtes sont absents.
# PUBLIC_BASE_URL=https://preprod.back.mission-transition-ecologique.incubateur.net

# Uploads Media : stockage objet Scaleway (API S3). Sans bucket configuré, les
# fichiers restent sur le disque local (dev) ; en prod ils seraient perdus à
# chaque déploiement. Les trois premières variables suffisent, les deux
# dernières ont des valeurs par défaut Scaleway Paris.
#
# Test en local : décommenter les trois premières lignes avec la clé API de
# l'application IAM Scaleway, relancer le serveur de dev, uploader un fichier
# dans Media, puis vérifier qu'il apparaît dans l'onglet « Fichiers » du bucket.
# Utiliser un bucket de dev ou de préprod, jamais celui de la prod : un média
# supprimé en local y serait supprimé aussi.
# S3_ENDPOINT = endpoint régional, PAS l'« Endpoint du bucket » de la console
# (qui contient le nom du bucket et fait échouer le SDK sur une erreur TLS).
# S3_BUCKET=tee-backoffice-media-pre-prod
# S3_ACCESS_KEY_ID=SCWXXXXXXXXXXXXXXXXX
# S3_SECRET_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# S3_REGION=fr-par
# S3_ENDPOINT=https://s3.fr-par.scw.cloud

# ---------------------------------------------------------------------------
# Déploiement Scalingo (étape `postdeploy` du Procfile, voir ADR 0012 §5 et §6)
# À ne pas définir en local.
# ---------------------------------------------------------------------------
# Préprod uniquement : réinitialise la base (schémas public et canonical) puis
# la reseed à chaque déploiement. La valeur doit être le NOM EXACT de l'app
# Scalingo (comparé à APP) : copiée sur une autre app, elle ne fait rien. Ne
# jamais la définir sur la prod.
# TEE_RESET_DATABASE_ON_DEPLOY=nom-de-l-app-preprod
#
# Seed des utilisateurs de test (mot de passe = email) malgré NODE_ENV=production.
# En permanence sur la préprod ; sur la prod, uniquement pour le premier seed
# (`scalingo run --env TEE_SEED_DEV_USERS=1 pnpm seed:scalingo`), puis changer
# leur mot de passe ou les supprimer. Inutile en local (seedés hors production).
# TEE_SEED_DEV_USERS=1

# ---------------------------------------------------------------------------
# Fournies par la plateforme, à NE PAS définir soi-même
# ---------------------------------------------------------------------------
# SCALINGO_POSTGRESQL_URL : DSN de l'addon PostgreSQL, injecté par Scalingo sur
# la prod et la préprod. Utilisé en repli quand DATABASE_URI est absente.
# APP : nom de l'app Scalingo, comparé à TEE_RESET_DATABASE_ON_DEPLOY.

# ---------------------------------------------------------------------------
# Pipeline quotidien (tâche planifiée Scalingo, `pnpm data:daily`)
# Sources amont lues par HTTP. Les valeurs par défaut pointent vers le dépôt
# betagouv/mission-transition-ecologique : à ne surcharger qu'en cas de
# déménagement de la source.
# ---------------------------------------------------------------------------
# TEE_PROGRAMS_URL=https://raw.githubusercontent.com/betagouv/mission-transition-ecologique/main/libs/data/static/programs.json
# TEE_PROJECTS_URL=https://raw.githubusercontent.com/betagouv/mission-transition-ecologique/main/libs/data/static/projects.json
# TEE_REDIRECTS_URL=https://raw.githubusercontent.com/betagouv/mission-transition-ecologique/main/libs/data/static/redirects.json

# Repli sur la copie versionnée des fichiers amont (libs/format-adapters/static/upstream/)
# quand GitHub est en panne (réseau, timeout, 5xx ; jamais sur un 404 ni un JSON
# invalide). Pratique en local pour `pnpm seed` et `import:tee`. Désactivé par
# défaut et REFUSÉ sur Scalingo (le job échoue avec une erreur explicite) : ne
# jamais la définir sur la prod ni la préprod.
TEE_UPSTREAM_LOCAL_FALLBACK=1

# ---------------------------------------------------------------------------
# Export Grist (libs/format-adapters, scripts `setup:grist` / `export:grist`)
# Hors application : en CI, ces valeurs viennent des secrets GitHub.
# ---------------------------------------------------------------------------
# GRIST_BASE_URL=https://grist.numerique.gouv.fr
# GRIST_DOC_ID=votre-doc-id
# GRIST_TABLE_ID=Dispositifs
# GRIST_API_KEY=votre-cle-api
# GRIST_PUSH=1
