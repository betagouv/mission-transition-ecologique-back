# PayloadCMS
PAYLOAD_SECRET=your-secret-here

# Database (SQLite — fichier local, pas de serveur requis)
# DATABASE_URI=file:./tee-poc.db  ← valeur par défaut, variable optionnelle
DATABASE_URI=file:./tee-poc.db

# URL publique utilisée pour les liens absolus AGIR (index /api/agir/programs).
# Requise en prod derrière un reverse proxy, sinon les liens pointent vers
# l'adresse interne du conteneur. En dev local, laisser vide : fallback sur req.origin.
PUBLIC_BASE_URL=https://preprod.back.mission-transition-ecologique.incubateur.net/
