# ---------------------------------------------------------------------------
# Variables d'environnement du CMS
# Toutes sont lues via `src/config/Config.ts` (point d'entrée unique).
# Copier ce fichier en `.env` et adapter les valeurs.
# ---------------------------------------------------------------------------

# PayloadCMS : secret de signature des tokens. Obligatoire.
# En prod, utiliser une valeur longue et aléatoire (`openssl rand -hex 32`).
PAYLOAD_SECRET=change-me-en-local

# Base Payload : PostgreSQL. Obligatoire en local et en CI.
# En prod et en préprod (Scalingo), ne rien définir : l'app retombe sur
# SCALINGO_POSTGRESQL_URL, injectée automatiquement par la plateforme.
DATABASE_URI=postgres://tee:tee@localhost:5432/tee

# Taille du pool de connexions Postgres. Optionnel, défaut : 5.
# DATABASE_POOL_MAX=5

# Base du store canonical (format pivot, indépendante de Payload).
# Optionnel aujourd'hui : défaut = libs/canonical-store/canonical.db.
# CANONICAL_DATABASE_URI=file:./canonical.db

# URL publique des liens absolus AGIR (index /api/agir/programs).
# Optionnel : sans elle, les liens viennent des en-têtes du reverse proxy,
# puis de l'origine de la requête. À définir si ces en-têtes sont absents.
# PUBLIC_BASE_URL=https://preprod.back.mission-transition-ecologique.incubateur.net

# ---------------------------------------------------------------------------
# Fournie par la plateforme, à NE PAS définir soi-même
# ---------------------------------------------------------------------------
# SCALINGO_POSTGRESQL_URL : DSN de l'addon PostgreSQL, injecté par Scalingo sur
# la prod et la préprod. Utilisé en repli quand DATABASE_URI est absente.

# ---------------------------------------------------------------------------
# Export Grist (libs/format-adapters, scripts `setup:grist` / `export:grist`)
# Hors application : en CI, ces valeurs viennent des secrets GitHub.
# ---------------------------------------------------------------------------
# GRIST_BASE_URL=https://grist.numerique.gouv.fr
# GRIST_DOC_ID=votre-doc-id
# GRIST_TABLE_ID=Dispositifs
# GRIST_API_KEY=votre-cle-api
# GRIST_PUSH=1
